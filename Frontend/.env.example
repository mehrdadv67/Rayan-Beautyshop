# ── Frontend (all environments) ────────────────────────────────
# Strapi backend (REST base + media host)
NEXT_PUBLIC_REST_API_ENDPOINT=http://localhost:1337
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────────
# These are safe to expose to the browser (anon key is public).
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Strapi (server-only — never expose to the browser) ──────────
# API token used by Next.js API routes to create/read orders
# in Strapi on behalf of authenticated Supabase users.
# Do NOT prefix these with NEXT_PUBLIC_ !
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your-strapi-server-api-token
