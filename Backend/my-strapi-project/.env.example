HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2,toBeModified3,toBeModified4"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Server
PUBLIC_URL=http://localhost:1337

# Email (SMTP provider via @strapi/provider-email-nodemailer; install it first: npm install @strapi/provider-email-nodemailer)
EMAIL_PROVIDER=sendmail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
EMAIL_REPLY_TO=
EMAIL_FROM_NAME=Strapi

# Email confirmation & password reset redirect URLs (frontend routes)
EMAIL_CONFIRMATION_REDIRECT_URL=http://localhost:3000
EMAIL_RESET_PASSWORD_URL=http://localhost:3000/reset-password

# JWT
JWT_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_ISSUER=https://accounts.google.com
