{
  "kind": "collectionType",
  "collectionName": "product_variants",
  "info": {
    "singularName": "product-variant",
    "pluralName": "product-variants",
    "displayName": "تنوع محصول"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "sku": {
      "type": "string",
      "unique": true,
      "required": true
    },
    "barcode": {
      "type": "string"
    },
    "weight": {
      "type": "decimal"
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "salePrice": {
      "type": "decimal"
    },
    "stock": {
      "type": "integer",
      "default": 0
    },
    "isDefault": {
      "type": "boolean",
      "default": false
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "desktopImages": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "mobileImages": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "inversedBy": "variants"
    },
    "options": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::variant-option.variant-option",
      "mappedBy": "variant"
    }
  }
}
